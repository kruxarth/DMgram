<?xml version="1.0" encoding="utf-8"?>
<!-- Instagram-style radial gradient, rising from the bottom-left corner:
     yellow, orange, pink, magenta, purple. The launcher crops it to its icon shape. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="28"
                android:centerY="96"
                android:gradientRadius="105">
                <item android:offset="0.05" android:color="#FFFFD600" />
                <item android:offset="0.2" android:color="#FFFF7A00" />
                <item android:offset="0.45" android:color="#FFFF0069" />
                <item android:offset="0.7" android:color="#FFD300C5" />
                <item android:offset="1" android:color="#FF7638FA" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
