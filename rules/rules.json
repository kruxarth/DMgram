{
  "schema": 1,
  "version": 1,
  "minAppVersionCode": 1,
  "hide": [],
  "css": "",
  "markers": {
    "sponsored": {
      "en": ["Sponsored", "Ad"],
      "es": ["Patrocinado", "Anuncio"],
      "pt": ["Patrocinado", "Anúncio"],
      "fr": ["Sponsorisé"],
      "de": ["Gesponsert", "Anzeige"],
      "id": ["Bersponsor", "Iklan"],
      "hi": ["प्रायोजित"]
    },
    "suggested": {
      "en": ["Suggested for you", "Suggested posts", "Suggested Posts", "Suggested reels"],
      "es": ["Sugerencias para ti", "Publicaciones sugeridas"],
      "pt": ["Sugestões para você", "Publicações sugeridas"],
      "fr": ["Suggestions pour vous"],
      "de": ["Vorschläge für dich"],
      "id": ["Saran untuk Anda"],
      "hi": ["आपके लिए सुझाव"]
    },
    "caughtUp": {
      "en": ["You're all caught up"],
      "es": ["Ya estás al día"],
      "pt": ["Você está em dia"],
      "fr": ["Vous êtes à jour"],
      "de": ["Du bist auf dem neuesten Stand"]
    },
    "nags": {
      "en": ["Use the app", "Open app", "Open Instagram"],
      "es": ["Usar la aplicación", "Abrir Instagram"],
      "pt": ["Usar o app", "Abrir o Instagram"],
      "fr": ["Utiliser l'application", "Ouvrir Instagram"],
      "de": ["App verwenden", "Instagram öffnen"]
    },
    "follow": {
      "en": ["Follow"],
      "es": ["Seguir"],
      "pt": ["Seguir"],
      "fr": ["Suivre"],
      "de": ["Folgen"],
      "id": ["Ikuti"],
      "hi": ["फ़ॉलो करें"]
    },
    "similar": {
      "en": ["Similar accounts"]
    }
  },
  "reserved": [
    "p",
    "reel",
    "reels",
    "explore",
    "stories",
    "direct",
    "accounts",
    "notifications",
    "about",
    "legal",
    "developer",
    "challenge",
    "privacy",
    "terms",
    "directory",
    "emails",
    "session",
    "graphql",
    "api"
  ],
  "routes": [
    { "class": "AUTH", "pattern": "^/accounts/login/?$" },
    { "class": "AUTH", "pattern": "^/accounts/signup(/.*)?$" },
    { "class": "AUTH", "pattern": "^/accounts/emailsignup(/.*)?$" },
    { "class": "AUTH", "pattern": "^/accounts/two_factor(/.*)?$" },
    { "class": "AUTH", "pattern": "^/accounts/onetap(/.*)?$" },
    { "class": "AUTH", "pattern": "^/accounts/password/reset(/.*)?$" },
    { "class": "AUTH", "pattern": "^/challenge(/.*)?$" },
    { "class": "ACCOUNT", "pattern": "^/accounts(/.*)?$" },
    { "class": "ACCOUNT", "pattern": "^/.*", "hosts": ["accountscenter.instagram.com"] },
    { "class": "HOME_FEED", "pattern": "^/?$" },
    { "class": "DIRECT_THREAD", "pattern": "^/direct/t/[^/]+/?$" },
    { "class": "DIRECT_INBOX", "pattern": "^/direct/(inbox|requests|new)/?$" },
    { "class": "STORY", "pattern": "^/stories/.+" },
    { "class": "REELS_FEED", "pattern": "^/reels(/.*)?$" },
    { "class": "REEL_SINGLE", "pattern": "^/reel/[^/]+/?$" },
    { "class": "REEL_SINGLE", "pattern": "^/[A-Za-z0-9._]{1,30}/reel/[^/]+/?$" },
    { "class": "POST", "pattern": "^/p/[^/]+/?$" },
    { "class": "POST", "pattern": "^/[A-Za-z0-9._]{1,30}/p/[^/]+/?$" },
    { "class": "SEARCH", "pattern": "^/explore/?$" },
    { "class": "SEARCH", "pattern": "^/explore/search/?$" },
    { "class": "EXPLORE_BLOCKED", "pattern": "^/explore/.+" },
    { "class": "ACTIVITY", "pattern": "^/notifications/?$" },
    { "class": "PROFILE", "pattern": "^/[A-Za-z0-9._]{1,30}/?$" },
    { "class": "PROFILE", "pattern": "^/[A-Za-z0-9._]{1,30}/(reels|reposts|tagged|followers|following|saved)/?$" }
  ]
}
